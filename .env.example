# FashionFit-PK Environment Variables
# Copy to .env.local (local) or add in Vercel Dashboard -> Settings -> Environment Variables

# Required for Stage 1 (Canonical Garment De-Occlusion) & Stage 3 (3-View Studio Generation)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Gemini multimodal image generation/editing model
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional: Live Colab GPU Server URL (can also be pasted directly in the Studio UI)
COLAB_GPU_URL=
